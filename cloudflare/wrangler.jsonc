{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "oddshot-storage",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "oddshot",
    "database_id": "f61103d3-7451-4c86-bd0c-dd6931c6f0ac",
    "migrations_dir": "migrations"
  }]
}
