# このファイルを .env.local にコピーし、そちらに認証情報を入力してください。
# キーやシークレットには NEXT_PUBLIC_ を付けないでください。

# OpenAI: 採点と写真タイトルの提案で同じ API キーを使います。
# キーの入力後、実際の AI を使う場合は demo を decisions に変更してください。
ODDSHOT_SCORING_MODE=demo
OPENAI_API_KEY=

# Google Drive: demo は表示確認、google は管理者の許可後に自動アップロードします。
# D1 の場合、先に cloudflare/migrations/0002_google_drive.sql を適用してください。
ODDSHOT_DRIVE_MODE=demo
# Google Cloud で作成した「ウェブアプリケーション」用 OAuth の情報。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 保存先フォルダ URL の /folders/ より後ろの ID。
# 実際に保存するには、管理者による Google 連携とフォルダの許可が必要です。
GOOGLE_DRIVE_FOLDER_ID=

# Google OAuth クライアントの承認済みリダイレクト URI に、同じ URL を登録。
# Vercel 本番では https://公開ドメイン/api/admin/drive/callback に変更します。
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/admin/drive/callback

# こちらの3値は別々に生成し、ローカルと Vercel で同じ値を設定。
# 管理画面のパスワード。32文字以上のランダムな値。
ODDSHOT_ADMIN_SECRET=
# 暗号化キー: ランダムな32バイトを base64url に変換した43文字。
# 保存済みの Google 接続を読むために必要なので、再起動で変えないでください。
ODDSHOT_GOOGLE_CREDENTIALS_KEY=
# 自動再試行の呼び出しに使う専用シークレット。32文字以上。
ODDSHOT_SYNC_SECRET=
# ローカルの再試行プログラム用。空欄なら127.0.0.1:3001を使用。
# 本番の Cloudflare Cron にも、同じ URL と ODDSHOT_SYNC_SECRET を登録します。
ODDSHOT_SYNC_CALLBACK_URL=

# refresh token は管理者の Google 連携で取得し、暗号化して DB に保存します。
# GOOGLE_REFRESH_TOKEN の手入力や Google Picker 用 API キーは不要です。

# 保存先: ローカルだけで試す場合は sqlite。本番 D1 は d1 にします。
ODDSHOT_STORAGE_MODE=sqlite

# Cloudflare D1: 認証付き Worker を通して接続します。すべてサーバー専用です。
ODDSHOT_D1_WORKER_URL=
ODDSHOT_D1_WORKER_TOKEN=

# 管理用の識別子。アプリ実行時は上の Worker 接続だけを使います。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# 管理 API を直接使う場合のみ。プラグインで管理する場合は空欄で構いません。
CLOUDFLARE_API_TOKEN=
